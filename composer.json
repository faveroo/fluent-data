{
    "name": "gabriel.hoffmann/fluent-data",
    "description": "Data-focused utility helpers for PHP collections, DTOs and pipelines",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gabriel\\FluentData\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "faveroo",
            "email": "gabriel290974@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    }
}
